# Reference only. Production secrets MUST be entered into hosting sensitive variables.
# Do not deploy before the existing live OAuth store is backed up and migration
# tested, or a separate reauthorization/downtime plan is explicitly approved.
JEV_AUTH_PROVIDER=github
JEV_GITHUB_CLIENT_ID=
JEV_GITHUB_CLIENT_SECRET=
JEV_RESOURCE_URL=https://bold-forge-l9kqr.run.mcp-use.com/mcp
JEV_INFERENCE_ENABLED=false
TYPESAFE_API_KEY=
# Dedicated remote Redis with TLS + server identity verification (not localhost).
# Example contains fake values only; do not commit actual connection URLs.
JEV_OAUTH_REDIS_URL=rediss://user:password@redis.example.invalid:6380/0
# Generate independent keys, store as sensitive, never rotate casually:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JEV_OAUTH_FERNET_KEY=
JEV_OAUTH_JWT_SIGNING_KEY=
JEV_BIND_HOST=0.0.0.0
PORT=8080
